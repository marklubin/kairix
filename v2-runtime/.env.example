# =============================================================================
# Kairix v2 Runtime - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=kairix

# -----------------------------------------------------------------------------
# API Keys
# -----------------------------------------------------------------------------
# OpenAI API key (for gpt-5.2, gpt-4o, etc via Letta)
OPENAI_API_KEY=sk-...

# DeepSeek/LLM API key (for BlockManagerAgent)
LLM_API_KEY=sk-...

# Deepgram API key (for voice STT)
DEEPGRAM_API_KEY=

# Anthropic API key (optional, for alternative models)
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Langfuse (LLM Observability)
# -----------------------------------------------------------------------------
# Generate these after first Langfuse login at http://localhost:3000
# Go to Settings -> API Keys -> Create API Key
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# Secrets for Langfuse auth (generate random 32+ char strings)
# Example: openssl rand -hex 16
LANGFUSE_NEXTAUTH_SECRET=changeme-generate-random-32-char-string
LANGFUSE_SALT=changeme-generate-random-salt-value

# -----------------------------------------------------------------------------
# TTS Configuration
# -----------------------------------------------------------------------------
TTS_PROVIDER=kokoro
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.2

# -----------------------------------------------------------------------------
# vLLM Configuration
# -----------------------------------------------------------------------------
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
VLLM_MAX_MODEL_LEN=16384

# -----------------------------------------------------------------------------
# Observability & Tracing
# -----------------------------------------------------------------------------
ENABLE_TRACING=true
ENABLE_METRICS=true

# -----------------------------------------------------------------------------
# Docker Compose Profiles
# -----------------------------------------------------------------------------
# Set to 'app' to start application services with 'docker compose up'
COMPOSE_PROFILES=app
