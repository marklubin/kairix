{
    admin off
}

# Main domain with HTTPS and redirect
kairix.net {
    # Reverse proxy for API server
    handle /api/* {
        reverse_proxy localhost:8000
    }

    # Serve website
    handle {
        reverse_proxy localhost:3000
    }

    # Enable compression
    encode gzip

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

# HTTP to HTTPS redirect
http://kairix.net {
    redir https://{host}{uri} permanent
}

# Existing subdomain configurations with HTTPS
x9d.kairix.net {
	basic_auth {
		f $2a$14$Zkx19XLiW6VYouLHR5NmfOFU0z2GTNmpkT/5qqR7hx4IjWJPDhjvG
	}

	handle_path / {
		reverse_proxy localhost:6010
	}

	handle_path /api/* {
		reverse_proxy localhost:7010
	}

	handle_path /tools/* {
		reverse_proxy localhost:8010
	}
}

