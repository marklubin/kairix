-- AgentEvent table - stores raw events from WebSocket
CREATE TABLE AgentEventEntity (
    id TEXT NOT NULL PRIMARY KEY,
    agent_id TEXT NOT NULL,
    event_type TEXT NOT NULL,
    payload TEXT NOT NULL,
    created_at TEXT NOT NULL
);

-- Index on created_at for efficient "most recent" queries
CREATE INDEX idx_created_at ON AgentEventEntity(created_at DESC);

-- Insert a new event (ignore if duplicate id)
insertEvent:
INSERT OR IGNORE INTO AgentEventEntity(id, agent_id, event_type, payload, created_at)
VALUES (?, ?, ?, ?, ?);

-- Check if event exists by ID
eventExists:
SELECT COUNT(*) FROM AgentEventEntity WHERE id = :id;

-- Select most recent N events (for startup loading)
selectRecentEvents:
SELECT * FROM AgentEventEntity ORDER BY created_at DESC LIMIT :limit;