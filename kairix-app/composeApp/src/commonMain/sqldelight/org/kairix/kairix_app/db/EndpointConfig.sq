CREATE TABLE EndpointConfigEntity (
    id TEXT NOT NULL PRIMARY KEY,
    label TEXT NOT NULL,
    base_url TEXT NOT NULL,
    voice_url TEXT NOT NULL,
    events_url TEXT NOT NULL,
    agent_id TEXT NOT NULL,
    is_selected INTEGER NOT NULL DEFAULT 0,
    created_at TEXT NOT NULL
);

CREATE INDEX idx_endpoint_selected ON EndpointConfigEntity(is_selected);

insertEndpoint:
INSERT INTO EndpointConfigEntity(id, label, base_url, voice_url, events_url, agent_id, is_selected, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectAllEndpoints:
SELECT * FROM EndpointConfigEntity ORDER BY created_at ASC;

selectSelectedEndpoint:
SELECT * FROM EndpointConfigEntity WHERE is_selected = 1 LIMIT 1;

selectEndpointById:
SELECT * FROM EndpointConfigEntity WHERE id = ?;

updateEndpoint:
UPDATE EndpointConfigEntity
SET label = ?, base_url = ?, voice_url = ?, events_url = ?, agent_id = ?
WHERE id = ?;

deleteEndpoint:
DELETE FROM EndpointConfigEntity WHERE id = ?;

clearSelection:
UPDATE EndpointConfigEntity SET is_selected = 0;

setSelected:
UPDATE EndpointConfigEntity SET is_selected = 1 WHERE id = ?;

countEndpoints:
SELECT COUNT(*) FROM EndpointConfigEntity;
