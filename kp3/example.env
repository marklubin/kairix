# KP3 Environment Configuration

# Database connection
DATABASE_URL=postgresql+asyncpg://kp3:kp3@localhost:5432/kp3

# DeepSeek API for world model extraction
DEEPSEEK_API_KEY=your-deepseek-api-key-here
# Optional: override base URL (defaults to https://api.deepseek.com)
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Letta integration
LETTA_BASE_URL=http://localhost:8283

# Ollama for embeddings (optional)
# OLLAMA_HOST=http://localhost:11434

# Anthropic for LLM prompting (optional)
# ANTHROPIC_API_KEY=your-anthropic-key-here
