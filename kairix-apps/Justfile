# Modern Python project with uv, ruff, ty, and typeguard

import "../justfile"

# Default - show available commands
default:
    @just --list

# Run all tests including agent verification
all-tests: test
    @echo "✅ All tests completed!"

# Watch mode - auto run checks on changes
watch:
    watchexec -e py -- just check lint

# Initialize project with Python 3.10
init:
    uv sync


run-user-server USER *ARGS:
    dotenv -e .envs/{{USER}}.env uv run python src/kairix_apps/server.py


run-app APP *ARGS:
  dotenv uv run python apps/{{APP}}.py {{ARGS}}

debug-app APP *ARGS:
    dotenv uv run python -m pudb apps/{{APP}}.py {{ARGS}}

server:
    dotenv uv run python src/kairix_apps/server.py

[working-directory: 'client']
client:
  npm install
  npm run build