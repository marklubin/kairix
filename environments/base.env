KAIRIX_INFERENCE_PROVIDER="ollama"
KAIRIX_INFERENCE_BASE_URL="https://ollama.kairix.net/v1" #Ignored when openai is set as provider
KAIRIX_INFERENCE_API_KEY="key-1244"

KAIRIX_SUMMARIZER_MODEL="q3-sum:latest"
KAIRIX_SUMMARIZER_ENABLE_QUANTIZATION=
KAIRIX_SUMMARIZER_BATCH_SIZE="20"
KAIRIX_SUMMARIZER_MAX_TOKENS="300"
KAIRIX_SUMMARIZER_TEMPERATURE=".5"

KAIRIX_SUMMARY_EXTRACTION_PARALLELISM=5

KAIRIX_N_SUMMARIES_PER_MESSAGE=5
KAIRIX_SUMMARIZATION_INTERVAL = 20
KAIRIX_MESSAGE_RETENTION_WINDOW = 20

# Disable tokenizers parallelism to prevent macOS debugger attachment
TOKENIZERS_PARALLELISM=false
KAIRIX_USE_LOG_FILE=1

