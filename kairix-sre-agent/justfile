#!/usr/bin/env just --justfile

# Default recipe to display help
default:
    @just --list

# Install dependencies using uv
install:
    uv sync

# Create a new user
new-user:
    uv run python kairixctl.py new-user

# List all users
list-users:
    uv run python kairixctl.py list-users

# Check user configuration
check-user name:
    uv run python kairixctl.py check-user {{name}}

# Run a health check cycle
sre-run *args="":
    uv run python -m sre_agent.main run {{args}}

# Start interactive shell
sre-shell *args="":
    uv run python -m sre_agent.main shell {{args}}

# Show agent status
sre-status hours="24":
    uv run python -m sre_agent.main status --hours {{hours}}

# Show all monitored services
sre-services:
    uv run python -m sre_agent.main services

# Run with verbose logging
sre-debug:
    uv run python -m sre_agent.main run --verbose

# Run linting
lint:
    uv run ruff check sre_agent/

# Fix linting issues
fix:
    uv run ruff check --fix sre_agent/

# Run type checking
mypy:
    uv run mypy sre_agent/

# Run all checks
check: lint mypy

# Run in watch mode (requires watchdog)
watch:
    uv run watchmedo auto-restart --directory=./sre_agent --pattern="*.py" --recursive -- python -m sre_agent.main run

# Clean up cache and temp files
clean:
    find . -type d -name "__pycache__" -exec rm -rf {} +
    find . -type f -name "*.pyc" -delete
    find . -type f -name "*.pyo" -delete
    find . -type f -name "*.pyd" -delete
    find . -type f -name ".coverage" -delete
    find . -type d -name "*.egg-info" -exec rm -rf {} +
    find . -type d -name ".pytest_cache" -exec rm -rf {} +
    find . -type d -name ".mypy_cache" -exec rm -rf {} +
    find . -type d -name ".ruff_cache" -exec rm -rf {} +

# Create systemd service file (requires sudo)
install-service:
    #!/usr/bin/env bash
    cat << EOF | sudo tee /etc/systemd/system/kairix-sre-agent.service
    [Unit]
    Description=Kairix SRE Agent
    After=network.target

    [Service]
    Type=simple
    User=$USER
    WorkingDirectory=$(pwd)
    ExecStart=$(which uv) run python -m sre_agent.main run
    Restart=always
    RestartSec=300

    [Install]
    WantedBy=multi-user.target
    EOF
    
    sudo systemctl daemon-reload
    echo "Service installed. Run 'sudo systemctl enable --now kairix-sre-agent' to start"

# Create cron job for periodic runs
install-cron:
    #!/usr/bin/env bash
    CRON_CMD="cd $(pwd) && $(which uv) run python -m sre_agent.main run >> /var/log/kairix/sre-agent/cron.log 2>&1"
    (crontab -l 2>/dev/null; echo "*/5 * * * * $CRON_CMD") | crontab -
    echo "Cron job installed to run every 5 minutes"

# View agent logs
logs lines="50":
    tail -n {{lines}} /var/log/kairix/sre-agent/*.log

# Run a test health check (dry run)
test:
    OPENAI_API_KEY=test uv run python -m sre_agent.main run --verbose