# Server Configuration
# Kairix Website Port - The port this website will run on
KAIRIX_WEBSITE_PORT=8888

# Vite HMR Configuration
# Set this to the hostname you're accessing the dev server from
# For local development: localhost
# For remote access: your machine's hostname or IP
# Example for Tailscale: mbp.thrush-escalator.ts.net
VITE_HMR_HOST=localhost

# Kairix Server Port - The Kairix API server should be running on this port
KAIRIX_SERVER_PORT=8000

# Context API URL (if using separate context service)
VITE_CONTEXT_API_URL=http://localhost:8001

# Feature Flags
VITE_ENABLE_CONTEXT_AWARENESS=true
VITE_ENABLE_SENSOR_STREAMING=false

# Context Collection Settings
VITE_CONTEXT_UPDATE_INTERVAL=30000
VITE_CONTEXT_LOCATION_THRESHOLD=50
VITE_CONTEXT_ANONYMIZE_DATA=false

# Sensor Streaming Settings
VITE_SENSOR_SAMPLE_RATE=60
VITE_SENSOR_BATCH_SIZE=10
VITE_SENSOR_POWER_MODE=balanced